-- ============================================================ instance helpers
local function Corner(o, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = (typeof(r) == "UDim") and r or UDim.new(0, r)
    c.Parent = o
    return c
end
local function Stroke(o, col, th, tr)
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = col or WHITE
    s.Thickness = th or 1
    s.Transparency = tr or 0
    s.Parent = o
    return s
end
local function Frame(parent, x, y, w, h, col, r)
    local f = Instance.new("Frame")
    f.BorderSizePixel = 0
    f.Position = UDim2.fromOffset(x, y)
    f.Size = UDim2.fromOffset(w, h)
    if col then f.BackgroundColor3 = col else f.BackgroundTransparency = 1 end
    if r and r ~= 0 then Corner(f, r) end
    f.Parent = parent
    return f
end
local CIRC = UDim.new(0.5, 0)
local function Circ(parent, cx, cy, r, col)
    return Frame(parent, cx - r, cy - r, r * 2, r * 2, col, CIRC)
end
local function Line(parent, x1, y1, x2, y2, th, col, round)
    local dx, dy = x2 - x1, y2 - y1
    local len = sqrt(dx * dx + dy * dy)
    local f = Instance.new("Frame")
    f.BorderSizePixel = 0
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
    f.Size = UDim2.fromOffset(len + (round and th or 0), th)
    f.Rotation = math.deg(math.atan2(dy, dx))
    f.BackgroundColor3 = col or WHITE
    if round then Corner(f, th / 2) end
    f.Parent = parent
    return f
end
-- текст, вертикально центрирован на cy. align: 0 лево, 0.5 центр, 1 право
local function Lab(parent, text, size, x, cy, col, weight, align, w, fade)
    local l = Instance.new("TextLabel")
    align = align or 0
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.FontFace = FONT[weight or "R"]
    l.TextSize = size
    l.TextColor3 = col or WHITE
    l.AnchorPoint = Vector2.new(align, 0.5)
    l.Position = UDim2.fromOffset(x, cy)
    l.Size = UDim2.fromOffset(w or 400, size + 8)
    l.TextXAlignment = align == 0 and Enum.TextXAlignment.Left or (align == 1 and Enum.TextXAlignment.Right or Enum.TextXAlignment.Center)
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextWrapped = false
    if w and fade and fade > 0 and fade < w then
        local g = Instance.new("UIGradient")
        g.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1 - fade / w, 0),
            NumberSequenceKeypoint.new(1, 1),
        })
        g.Parent = l
    end
    if type(text) == "function" then
        Stat(function() local t = text(); if l.Text ~= t then l.Text = t end end)
    else
        l.Text = text
    end
    l.Parent = parent
    return l
end

