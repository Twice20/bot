local UpdateTip, UpdateToast
do
local tipF = Frame(LayerTop, 0, 0, 100, 26, LC.TIP, 6); tipF.Visible = false
local tipS = Stroke(tipF, LC.BORDER, 1)
local tipL = Lab(tipF, "", 13, 8, 13, LC.TEXT, "R", 0, 600)

local toastF = Frame(LayerTop, 0, 0, 100, 34, LC.POPUP, 17)
toastF.AnchorPoint = Vector2.new(0.5, 0); toastF.Visible = false
local toastS = Stroke(toastF, LC.BORDER, 1)
local toastL = Lab(toastF, "", 14, 50, 17, LC.WHITE, "M", 0.5, 800)

function UpdateTip()
    local text, style
    for _, t in ipairs(Tips) do
        if t.s.over() then t.s.t = t.s.t + DT else t.s.t = 0 end
        if not text and t.s.t >= t.delay and not IS_MOBILE then
            local s = t.fn()
            if s then text, style = s, t.style end
        end
    end
    if not text then tipF.Visible = false; return end
    local size = style == "loader" and 13 or 14
    local w = TW(text, size) + 18
    tipL.TextSize = size; tipL.Text = text
    tipL.Position = UDim2.fromOffset(w / 2, 13); tipL.Size = UDim2.fromOffset(w, 22)
    tipL.TextXAlignment = Enum.TextXAlignment.Center; tipL.AnchorPoint = Vector2.new(0.5, 0.5)
    if style == "loader" then
        tipF.BackgroundColor3 = LC.TIP; tipS.Color = LC.BORDER; tipL.TextColor3 = LC.TEXT
    else
        tipF.BackgroundColor3 = P.win; tipS.Color = P.popupBorder; tipL.TextColor3 = P.text
    end
    local m = UIS:GetMouseLocation() - Gui.AbsolutePosition
    local v = VP()
    tipF.Size = UDim2.fromOffset(w, 26)
    tipF.Position = UDim2.fromOffset(clamp(m.X + 14, 4, v.X - w - 4), clamp(m.Y + 18, 4, v.Y - 30))
    tipF.Visible = true
end

function UpdateToast()
    if ToastT <= 0 then toastF.Visible = false; return end
    ToastT = ToastT - DT
    local a = min(Sat(ToastT / 0.35), Sat((2.6 - ToastT) / 0.2))
    local w = TW(ToastText, 14, 1.04) + 36
    toastL.Text = ToastText
    toastL.Position = UDim2.fromOffset(w / 2, 17); toastL.Size = UDim2.fromOffset(w, 30)
    toastF.Size = UDim2.fromOffset(w, 34)
    toastF.Position = UDim2.new(0.5, 0, 0, (IS_MOBILE and 52 or 22) - (1 - a) * 10)
    toastF.BackgroundTransparency = 1 - a; toastS.Transparency = 1 - a
    toastL.TextTransparency = 1 - a
    toastF.Visible = true
end

end

