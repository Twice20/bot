local function ClampWin(W)
    local v = VP()
    local p = W.holder.Position
    local w, h = W.w * S, W.h * S
    W.holder.Position = UDim2.fromOffset(clamp(p.X.Offset, -w + 80, v.X - 80), clamp(p.Y.Offset, 0, v.Y - 40))
end
local function Layout()
    local v = VP()
    local sW, sH, stW, gap = 838 * S, 559 * S, 323 * S, 16 * S
    local top = IS_MOBILE and 40 or 0
    local my = max(top + 4, (v.Y - sH) / 2 + top / 2)
    if not IS_MOBILE and sW + gap + stW <= v.X * 0.98 then
        local x0 = (v.X - (sW + gap + stW)) / 2
        MW.holder.Position = UDim2.fromOffset(x0, my)
        SW.holder.Position = UDim2.fromOffset(x0 + sW + gap, my)
    else
        local mx = (v.X - sW) / 2
        MW.holder.Position = UDim2.fromOffset(mx, my)
        SW.holder.Position = UDim2.fromOffset(max(4, mx + sW - stW - 10 * S), my + 30 * S)
    end
end
function ApplyScale()
    S = CalcMenuScale()
    MW.uis.Scale = S; SW.uis.Scale = S
    MW.scaled.Size = UDim2.fromOffset(838, 559)
    ClampWin(MW); ClampWin(SW)
end

