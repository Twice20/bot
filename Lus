local function RGB(r, g, b) return Color3.fromRGB(clamp(r, 0, 255), clamp(g, 0, 255), clamp(b, 0, 255)) end
local function Mix(a, b, t) return a:Lerp(b, clamp(t, 0, 1)) end
local function Shade(c, k) if k >= 0 then return c:Lerp(WHITE, k) end return c:Lerp(BLACK, -k) end
local function LogoLight(acc) local h, s = acc:ToHSV() return Color3.fromHSV(h, 0.23 * s, 1) end

