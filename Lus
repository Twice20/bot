-- ============================================================ input
Con(UIS.InputBegan, function(input)
    if gListen then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Escape then UF.StopListening() else UF.SetKey(input.KeyCode) end
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
            UF.SetKey(Enum.UserInputType.MouseButton3)
        end
        return
    end
    if not menuReady or UIS:GetFocusedTextBox() then return end
    if input.KeyCode == st.menuKey or input.UserInputType == st.menuKey then UF.ToggleMenu() end
end)

