-- ============================================================ icons (vector, 16x16 grid)
local IconDefs = {}

local function Icon(parent, name, cx, cy, size, c1, c2)
    local holder = Frame(parent, cx, cy, 0, 0, nil)
    local root = Frame(holder, 0, 0, 16, 16, nil)
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    local sc = Instance.new("UIScale"); sc.Scale = (size or 16) / 16; sc.Parent = root
    local parts = {}
    local function reg(f, mode, role) parts[#parts + 1] = { f = f, mode = mode, role = role or 1 } return f end
    local B = {}
    function B.line(x1, y1, x2, y2, th, role) return reg(Line(root, x1, y1, x2, y2, th or 1.5, WHITE, true), "bg", role) end
    function B.circ(x, y, r, role) return reg(Circ(root, x, y, r, WHITE), "bg", role) end
    function B.rect(x, y, w, h, r, role) return reg(Frame(root, x, y, w, h, WHITE, r), "bg", role) end
    function B.ring(x, y, r, th, role)
        local f = Frame(root, x - r, y - r, r * 2, r * 2, nil, CIRC)
        reg(Stroke(f, WHITE, th), "stroke", role); return f
    end
    function B.rrect(x, y, w, h, r, th, role)
        local f = Frame(root, x, y, w, h, nil, r)
        reg(Stroke(f, WHITE, th), "stroke", role); return f
    end
    function B.stad(x, y, w, h, th, role)
        local f = Frame(root, x, y, w, h, nil, CIRC)
        reg(Stroke(f, WHITE, th), "stroke", role); return f
    end
    function B.text(txt, sz, weight, role)
        local l = Lab(root, txt, sz, 8, 8, WHITE, weight or "B", 0.5, 16)
        reg(l, "text", role); return l
    end
    function B.root() return root end
    function B.reg(f, role) return reg(f, "bg", role) end
    local def = IconDefs[name]
    if def then def(B) end
    local obj = { holder = holder, root = root, scale = sc }
    function obj.set(a, b)
        for i = 1, #parts do
            local p = parts[i]
            local c = (p.role == 2 and b) or a
            if c then
                if p.mode == "stroke" then if p.f.Color ~= c then p.f.Color = c end
                elseif p.mode == "text" then if p.f.TextColor3 ~= c then p.f.TextColor3 = c end
                else if p.f.BackgroundColor3 ~= c then p.f.BackgroundColor3 = c end end
            end
        end
    end
    obj.set(c1 or WHITE, c2)
    return obj
end

local function Star(B, cx, cy, r)
    local n, th = 5, max(1.0, r * 0.26)
    for i = 0, 3 do
        local a0 = -pi / 2 + i * pi / 2
        local a1, am = a0 + pi / 2, a0 + pi / 4
        local p0x, p0y = cx + cos(a0) * r, cy + sin(a0) * r
        local p1x, p1y = cx + cos(a1) * r, cy + sin(a1) * r
        local qx, qy = cx + cos(am) * r * 0.10, cy + sin(am) * r * 0.10
        for k = 0, n - 1 do
            local t = (k + 0.5) / n
            local u = 1 - t
            B.line(cx, cy, u * u * p0x + 2 * u * t * qx + t * t * p1x, u * u * p0y + 2 * u * t * qy + t * t * p1y, th)
        end
    end
end

