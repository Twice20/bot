local Anims = {}
-- меню: скорость зависит от "Animation Duration"
local function Anim(key, target, speed)
    speed = speed or 14
    local v = Anims[key]
    if v == nil then Anims[key] = target; return target end
    local dur = max(10, st.animDur) / 100
    v = v + (target - v) * (1 - exp(-speed * DT / dur))
    if abs(target - v) < 0.002 then v = target end
    Anims[key] = v
    return v
end
-- лоадер: фиксированная скорость
local function LAnim(key, target, speed)
    speed = speed or 14
    local v = Anims[key]
    if v == nil then Anims[key] = target; return target end
    v = v + (target - v) * (1 - exp(-speed * DT))
    if abs(target - v) < 0.001 then v = target end
    Anims[key] = v
    return v
end
