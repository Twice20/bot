-- ============================================================ umbrella logo
-- R - радиус внешних углов, colFn() -> тёмный, светлый, контур
local function MakeLogo(parent, cx, cy, R, colFn)
    local small = R < 13
    local S = R * 2 + 6
    local cg = Instance.new("CanvasGroup")
    cg.BackgroundTransparency = 1; cg.BorderSizePixel = 0
    cg.AnchorPoint = Vector2.new(0.5, 0.5)
    cg.Position = UDim2.fromOffset(cx, cy)
    cg.Size = UDim2.fromOffset(S, S)
    cg.Parent = parent
    local sc = Instance.new("UIScale"); sc.Parent = cg
    local c = S / 2
    local dark, light, outl = {}, {}, {}
    local n = small and 5 or 7
    local function curve(i, t)
        local a0 = -pi / 2 - pi / 8 + i * pi / 4
        local a1, am = a0 + pi / 4, a0 + pi / 8
        local p0x, p0y = c + cos(a0) * R, c + sin(a0) * R
        local p1x, p1y = c + cos(a1) * R, c + sin(a1) * R
        local qx, qy = c + cos(am) * R * 0.766, c + sin(am) * R * 0.766
        local u = 1 - t
        return u * u * p0x + 2 * u * t * qx + t * t * p1x, u * u * p0y + 2 * u * t * qy + t * t * p1y
    end
    local th = (2 * pi * R / 8 / n) * 1.35 + 0.4
    for pass = 0, 1 do
        for i = pass, 7, 2 do
            for k = 0, n - 1 do
                local x, y = curve(i, (k + 0.5) / n)
                local f = Line(cg, c, c, x, y, th, WHITE, false)
                if pass == 0 then dark[#dark + 1] = f else light[#light + 1] = f end
            end
        end
    end
    for i = 0, 7 do
        local x, y = curve(i, 0)
        outl[#outl + 1] = Line(cg, c, c, x, y, 1, WHITE, false)
        if not small then
            local px, py = x, y
            for k = 1, 4 do
                local qx, qy = curve(i, k / 4)
                outl[#outl + 1] = Line(cg, px, py, qx, qy, 1, WHITE, false)
                px, py = qx, qy
            end
        end
    end
    for _, f in ipairs(outl) do f.BackgroundTransparency = 0.25 end
    Stat(function()
        local d, l, o = colFn()
        for _, f in ipairs(dark) do f.BackgroundColor3 = d end
        for _, f in ipairs(light) do f.BackgroundColor3 = l end
        for _, f in ipairs(outl) do f.BackgroundColor3 = o end
    end)
    return { group = cg, scale = sc }
end

