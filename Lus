-- ============================================================ key (обфусцирован: хранится только хэш)
local KeyOK, SaveKey, LoadKey, ForgetKey, Trim
do
local KH = { 1320766901, 1468100962 }
local KMASK = 523124044
local function KHash(s, mul, add, mod, seed)
    local v = seed
    for i = 1, #s do v = (v * mul + s:byte(i) + add + (i - 1)) % mod end
    return v
end
function KeyOK(s)
    if type(s) ~= "string" or #s ~= 15 then return false end
    return KHash(s, 131, 7, 2147483629, 5381) == bit32.bxor(KH[1], KMASK)
       and KHash(s, 257, 13, 2147483587, 977) == bit32.bxor(KH[2], KMASK)
end
local KEYFILE = "UmbrellaFan/key.dat"
local function Enc(s)
    local o = {}
    for i = 1, #s do o[i] = string.format("%02x", bit32.bxor(s:byte(i), (i * 37 + 11) % 256)) end
    return table.concat(o)
end
local function Dec(h)
    local o, n = {}, 0
    for i = 1, #h - 1, 2 do
        local b = tonumber(h:sub(i, i + 1), 16)
        if not b then return "" end
        n = n + 1
        o[n] = string.char(bit32.bxor(b, (n * 37 + 11) % 256))
    end
    return table.concat(o)
end
function SaveKey(s)
    ENV.__UF_KEY = Enc(s)
    pcall(function()
        if makefolder and isfolder and not isfolder("UmbrellaFan") then makefolder("UmbrellaFan") end
        if writefile then writefile(KEYFILE, Enc(s)) end
    end)
end
function LoadKey()
    local raw
    pcall(function() if isfile and readfile and isfile(KEYFILE) then raw = readfile(KEYFILE) end end)
    raw = raw or ENV.__UF_KEY
    if type(raw) == "string" and #raw > 0 then
        local k = Dec(raw)
        if KeyOK(k) then return k end
    end
    return nil
end
function ForgetKey()
    ENV.__UF_KEY = nil
    pcall(function() if delfile and isfile and isfile(KEYFILE) then delfile(KEYFILE) end end)
end
function Trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end

end

