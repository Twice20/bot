        p.card = Shade(base, -0.28); p.cardBorder = Shade(base, 0.03); p.sep = Shade(base, 0.04)
        p.sel = Mix(Shade(base, 0.05), acc, 0.14); p.combo = Shade(base, 0.027); p.comboHover = Shade(base, 0.06)
