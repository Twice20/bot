local function ApplyTheme(instant)
    if st.theme >= 1 and st.theme <= NTHEME then
        local t = THEMES[st.theme]
        PT = MakePal(t.base, t.acc, t.light)
    else
        PT = MakePal(THEMES[1].base, st.customAccent, false)
    end
    if instant then for k, v in pairs(PT) do P[k] = v end Ver = Ver + 1 end
end

local function StepCh(f, t, k)
    f = floor(f * 255 + 0.5); t = floor(t * 255 + 0.5)
    local d = t - f
    local s = floor(d * k + 0.5)
    if s == 0 and d ~= 0 then s = d > 0 and 1 or -1 end
    return (f + s) / 255
end

local function TickPalette()
    local k = 1 - exp(-14 * DT / (max(10, st.animDur) / 100))
    local changed = false
    for key, dst in pairs(PT) do
        local cur = P[key]
        if cur ~= dst then
            P[key] = Color3.new(StepCh(cur.R, dst.R, k), StepCh(cur.G, dst.G, k), StepCh(cur.B, dst.B, k))
            changed = true
        end
    end
    if changed then Ver = Ver + 1 end
end

