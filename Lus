-- ============================================================ main loop
local failed = {}
local function Run(fn)
    local ok, err = pcall(fn)
    if not ok and not failed[fn] then
        failed[fn] = true
        warn("[UmbrellaFan] " .. tostring(err))
    end
end

local function Step(dt)
    DT = clamp(dt, 0.0001, 0.1)
    NOW = NOW + DT
    TickPalette()
    if Ver ~= DoneVer then
        DoneVer = Ver
        for i = 1, #Static do Run(Static[i]) end
    end
    for i = #Drags, 1, -1 do
        local d = Drags[i]
        if InputEnded(d.inp) then
            table.remove(Drags, i)
            if d.fin then Run(d.fin) end
        elseif d.move then
            local ok, err = pcall(d.move, Ptr(d.inp))
            if not ok and not failed[d.move] then failed[d.move] = true; warn("[UmbrellaFan] " .. tostring(err)) end
        end
    end
    for gi = 1, #Groups do
        local g = Groups[gi]
        if g.on() then
            local list = g.dyn
            for i = 1, #list do Run(list[i]) end
        end
    end
    Run(UpdateTip)
    Run(UpdateToast)
end
Con(game:GetService("RunService").RenderStepped, Step)
