local function Hit(parent, x, y, w, h)
    local b = Instance.new("TextButton")
    b.Text = ""
    b.AutoButtonColor = false
    b.BackgroundTransparency = 1
    b.BorderSizePixel = 0
    b.Position = UDim2.fromOffset(x, y)
    b.Size = UDim2.fromOffset(w, h)
    b.Parent = parent
    local s = { btn = b, hov = false, down = false, t = 0 }
    b.MouseEnter:Connect(function() s.hov = true end)
    b.MouseLeave:Connect(function() s.hov = false end)
    b.InputBegan:Connect(function(i)
        local t = i.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            s.down = true
            if t == Enum.UserInputType.Touch then s.hov = true end
        end
    end)
    b.InputEnded:Connect(function(i)
        local t = i.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            s.down = false
            if t == Enum.UserInputType.Touch then s.hov = false end
        end
    end)
    function s.click(fn) b.Activated:Connect(fn) end
    function s.over() return s.hov and b.Visible end
    return s
end

-- позиция указателя в экранных координатах
local function Ptr(i)
    local p
    if i and i.UserInputType == Enum.UserInputType.Touch then
        p = Vector2.new(i.Position.X, i.Position.Y) + (GuiService:GetGuiInset())
    else
        p = UIS:GetMouseLocation()
    end
    return p          -- экранные координаты (как AbsolutePosition)
end
local function InputEnded(i)
    if i.UserInputType == Enum.UserInputType.Touch then
        return i.UserInputState == Enum.UserInputState.End or i.UserInputState == Enum.UserInputState.Cancel
    end
    return not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
end
local function Dragger(obj, onBegin, onMove, onEnd)
    obj.InputBegan:Connect(function(i)
        local t = i.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            Drags[#Drags + 1] = { inp = i, move = onMove, fin = onEnd }
            local p = Ptr(i)
            if onBegin then onBegin(p) end
            if onMove then onMove(p) end
        end
    end)
end
-- перетаскивание окна за пустое место
local function DragWindow(obj, holder)
    local sp, so
    obj.Active = true
    Dragger(obj, function(p) sp = p; so = holder.Position end, function(p)
        if not sp then return end
        local d = p - sp
        holder.Position = UDim2.new(so.X.Scale, so.X.Offset + d.X, so.Y.Scale, so.Y.Offset + d.Y)
    end, function() sp = nil end)
end

