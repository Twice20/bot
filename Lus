local function RowSlider(C, icon, label, get, set, mn, mx, fmt, h, labelOff, trackOff)
    local r = C.row(h)
    local right = C.w - 12
    local ly, ty = r.y0 + labelOff, r.y0 + trackOff
    local lab = RowLabel(C, r, icon, label, right - 50, ly)
    Th(lab, "TextColor3", "text")
    local val = Lab(C.f, "", KT, right, ly, P.text, "R", 1, 60)
    local tw = right - 12
    local track = Frame(C.f, 12, ty - 2.5, tw, 5, P.sliderBg, 2.5)
    local fill = Frame(C.f, 12, ty - 2.5, 10, 5, P.accent, 2.5)
    local knob = Circ(C.f, 0, ty, 6, P.knob)
    local ks = Stroke(knob, P.popupBorder, 1, 0.2)
    local hit = Hit(C.f, 8, ty - 9, tw + 8, 18)
    local isInt = fmt:find("%%.0f") ~= nil
    Dragger(hit.btn, nil, function(p)
        local ap = track.AbsolutePosition
        local t = Sat((p.X - ap.X - 6 * S) / ((tw - 12) * S))
        local nv = mn + (mx - mn) * t
        if isInt then nv = floor(nv + 0.5) end
        set(nv)
    end)
    Dyn(C.g, function()
        local v = get()
        val.Text = string.format(fmt, v); val.TextColor3 = P.text
        local t = Sat((v - mn) / (mx - mn))
        local kx = 12 + 6 + (tw - 12) * t
        track.BackgroundColor3 = P.sliderBg
        fill.BackgroundColor3 = P.accent; fill.Size = UDim2.fromOffset(kx - 12, 5)
        local ka = Anim(hit, (hit.down or hit.over()) and 1 or 0)
        local rr = 6 + ka * 0.8
        knob.Size = UDim2.fromOffset(rr * 2, rr * 2); knob.Position = UDim2.fromOffset(kx - rr, ty - rr)
        knob.BackgroundColor3 = P.knob; ks.Color = P.popupBorder
    end)
end

local function RowToggle(C, icon, label, get, set)
    local r = C.row(38)
    local right = C.w - 12
    local ic = Icon(C.f, icon, 22, r.cy, 15, P.iconOff)
    local lab = Lab(C.f, function() return T(label) end, KT, 40, r.cy, P.text, "R", 0, right - 34 - 40, 12)
    local track = Frame(C.f, right - 30, r.cy - 8, 30, 16, P.offTrack, 8)
    local knob = Circ(C.f, 0, r.cy, 8, P.knobOff)
    local hit = Hit(C.f, 0, r.y0, C.w, 38)
    hit.click(function() set(not get()) end)
    Dyn(C.g, function()
        local on = get()
        local t = Anim(knob, on and 1 or 0, 16)
        local lt = Anim(lab, on and 1 or 0, 16)
        local tc = Mix(P.text, P.textBright, lt)
        if hit.over() and not on then tc = Mix(tc, P.textBright, 0.25) end
        lab.TextColor3 = tc
        ic.set(Mix(P.iconOff, P.accent, lt))
        track.BackgroundColor3 = Mix(P.offTrack, Mix(P.card, P.accent, 0.17), t)
        local kx = right - 30 + 8 + (30 - 16) * t
        knob.Position = UDim2.fromOffset(kx - 8, r.cy - 8)
        knob.BackgroundColor3 = Mix(P.knobOff, P.accent, t)
    end)
end

